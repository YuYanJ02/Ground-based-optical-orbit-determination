                Title		 Time
                NameInTitle		 No
                Service		 Ric
                Type		 Fixed
                Element		 Time
                SumAllowedMask		 1559
                SummaryOnly		 No
                DataType		 0
                UnitType		 2
                LineStyle		 0
                LineWidth		 0
                PointStyle		 0
                PointSize		 0
                FillPattern		 0
                LineColor		 #000000
                FillColor		 #000000
                PropMask		 0
                UseScenUnits		 Yes
            END Element
        END Line

        BEGIN Line
            Name		 Line 2
            Title		 Radial,In-Track,Cross-Track
            NumElements		 4

            BEGIN Element
                Name		 RIC Coordinates-Fixed-Radial
                IsIndepVar		 No
                IndepVarName		 Time
                Title		 Radial
                NameInTitle		 Yes
                Service		 Ric
                Type		 Fixed
                Element		 Radial
                SumAllowedMask		 1559
                SummaryOnly		 No
                DataType		 0
                UnitType		 0
                LineStyle		 2
                LineWidth		 2
                PointStyle		 1
                PointSize		 4
                FillPattern		 0
                LineColor		 #ff0000
                FillColor		 #000000
                PropMask		 0
                UseScenUnits		 Yes
            END Element

            BEGIN Element
                Name		 RIC Coordinates-Fixed-In-Track
                IsIndepVar		 No
                IndepVarName		 Time
                Title		 In-Track
                NameInTitle		 Yes
                Service		 Ric
                Type		 Fixed
                Element		 In-Track
                SumAllowedMask		 1559
                SummaryOnly		 No
                DataType		 0
                UnitType		 0
                LineStyle		 2
                LineWidth		 2
                PointStyle		 1
                PointSize		 4
                FillPattern		 0
                LineColor		 #6b8e23
                FillColor		 #000000
                PropMask		 0
                UseScenUnits		 Yes
            END Element

            BEGIN Element
                Name		 RIC Coordinates-Fixed-Cross-Track
                IsIndepVar		 No
                IndepVarName		 Time
                Title		 Cross-Track
                NameInTitle		 Yes
                Service		 Ric
                Type		 Fixed
                Element		 Cross-Track
                SumAllowedMask		 1559
                SummaryOnly		 No
                DataType		 0
                UnitType		 0
                LineStyle		 2
                LineWidth		 2
                PointStyle		 1
                PointSize		 4
                FillPattern		 0
                LineColor		 #0000ff
                FillColor		 #000000
                PropMask		 0
                UseScenUnits		 Yes
            END Element

            BEGIN Element
                Name		 RIC Coordinates-Range
                IsIndepVar		 No
                IndepVarName		 Time
                Title		 Range
                NameInTitle		 Yes
                Service		 Ric
                Element		 Range
                SumAllowedMask		 1559
                SummaryOnly		 No
                DataType		 0
                UnitType		 0
                LineStyle		 2
                LineWidth		 2
                PointStyle		 1
                PointSize		 4
                FillPattern		 0
                LineColor		 #000000
                FillColor		 #000000
                PropMask		 0
                UseScenUnits		 Yes
            END Element
        END Line
    END Section

    BEGIN Section
        Name		 Section 2
        NameInTitle		 No
        ExpandMethod		 0
        PropMask		 0
        ShowIntervals		 No
        NumIntervals		 0
        NumLines		 2

        BEGIN Line
            Name		 Line 1
            NumElements		 0
        END Line

        BEGIN Line
            Name		 Line 2
            Title		 Range
            NumElements		 0
        END Line
    END Section

    BEGIN LineAnnotations
    END LineAnnotations
END ReportStyle

