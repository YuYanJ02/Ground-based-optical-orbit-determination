<?xml version = "1.0" standalone = "yes"?>
<VAR name = "Moon2Body">
    <SCOPE Class = "Propagator">
        <VAR name = "Version">
            <STRING>&quot;1.0.0 a&quot;</STRING>
        </VAR>
        <VAR name = "STKVersion">
            <INT>1220</INT>
        </VAR>
        <VAR name = "Description">
            <STRING>&quot;Numerical propagator using HPOP&quot;</STRING>
        </VAR>
        <VAR name = "Type">
            <STRING>&quot;NumericalPropagatorWrapper&quot;</STRING>
        </VAR>
        <VAR name = "UserComment">
            <STRING>&quot;For Earth-centered orbits within Moon&apos;s orbit&quot;</STRING>
        </VAR>
        <VAR name = "ReadOnly">
            <BOOL>false</BOOL>
        </VAR>
        <VAR name = "Clonable">
            <BOOL>true</BOOL>
        </VAR>
        <VAR name = "Category">
            <STRING>&quot;@Top&quot;</STRING>
        </VAR>
        <VAR name = "ShooterControls">
            <LIST />
        </VAR>
        <VAR name = "CentralBody">
            <LINKTOOBJ>
                <STRING>&quot;Moon&quot;</STRING>
            </LINKTOOBJ>
        </VAR>
        <VAR name = "NumericalIntegrator">
            <VAR name = "CisLunar_RKF7th8th">
                <SCOPE Class = "NumIntegrator">
                    <VAR name = "Version">
                        <STRING>&quot;1.0.0 a&quot;</STRING>
                    </VAR>
                    <VAR name = "STKVersion">
                        <INT>1220</INT>
                    </VAR>
                    <VAR name = "Description">
                        <STRING>&quot;8th order Runge-Kutta-Fehlberg with 7th order error control&quot;</STRING>
                    </VAR>
                    <VAR name = "Type">
                        <STRING>&quot;RKF7th8th&quot;</STRING>
                    </VAR>
                    <VAR name = "UserComment">
                        <STRING>&quot;8th order Runge-Kutta-Fehlberg with 7th order error control&quot;</STRING>
                    </VAR>
                    <VAR name = "ReadOnly">
                        <BOOL>false</BOOL>
                    </VAR>
                    <VAR name = "Clonable">
                        <BOOL>true</BOOL>
                    </VAR>
                    <VAR name = "Category">
                        <STRING>&quot;&quot;</STRING>
                    </VAR>
                    <VAR name = "ShooterControls">
                        <LIST />
                    </VAR>
                    <VAR name = "InitialStep">
                        <QUANTITY Dimension = "TimeUnit" Unit = "sec">
                            <REAL>60</REAL>
                        </QUANTITY>
                    </VAR>
                    <VAR name = "UseFixedStep">
                        <BOOL>false</BOOL>
                    </VAR>
                    <VAR name = "MaxIterations">
                        <INT>100</INT>
                    </VAR>
                    <VAR name = "UseMaxStep">
                        <BOOL>true</BOOL>
                    </VAR>
                    <VAR name = "UseMinStep">
                        <BOOL>false</BOOL>
                    </VAR>
                    <VAR name = "MaxStep">
                        <QUANTITY Dimension = "TimeUnit" Unit = "sec">
                            <REAL>86400</REAL>
                        </QUANTITY>
                    </VAR>
                    <VAR name = "MinStep">
                        <QUANTITY Dimension = "TimeUnit" Unit = "sec">
                            <REAL>1</REAL>
                        </QUANTITY>
                    </VAR>
                    <VAR name = "MaxRelError">
                        <REAL>1e-13</REAL>
                    </VAR>
                    <VAR name = "MaxAbsError">
                        <REAL>9.999999999999999e-12</REAL>
                    </VAR>
                    <VAR name = "SCHigh">
                        <REAL>0.9</REAL>
                    </VAR>
                    <VAR name = "SCLow">
                        <REAL>1</REAL>
                    </VAR>
                    <VAR name = "ErrorControl">
                        <STRING>&quot;Relative to state&quot;</STRING>
                    </VAR>
                    <VAR name = "StepTruncationThreshold">
                        <REAL>0.1</REAL>
                    </VAR>
                    <VAR name = "StepTruncationRounding">
                        <REAL>0.001</REAL>
                    </VAR>
                </SCOPE>
            </VAR>
        </VAR>
        <VAR name = "PropFuncs">
            <LIST>
                <VAR name = "Gravitational_Force">
                    <SCOPE Class = "EOMFuncWrapper">
                        <VAR name = "Version">
                            <STRING>&quot;1.0.0 a&quot;</STRING>
                        </VAR>
                        <VAR name = "STKVersion">
                            <INT>1220</INT>
                        </VAR>
                        <VAR name = "Description">
                            <STRING>&quot;Gravitational force from central body&quot;</STRING>
                        </VAR>
                        <VAR name = "Type">
                            <STRING>&quot;GravityFieldFunc&quot;</STRING>
                        </VAR>
                        <VAR name = "UserComment">
                            <STRING>&quot;Gravitational force from central body&quot;</STRING>
                        </VAR>
                        <VAR name = "ReadOnly">
                            <BOOL>false</BOOL>
                        </VAR>
                        <VAR name = "Clonable">
                            <BOOL>true</BOOL>
                        </VAR>
                        <VAR name = "Category">
                            <STRING>&quot;Gravity Models&quot;</STRING>
                        </VAR>
                        <VAR name = "ShooterControls">
                            <LIST />
                        </VAR>
                        <VAR name = "CentralBody">
                            <LINKTOOBJ>
                                <STRING>&quot;Moon&quot;</STRING>
                            </LINKTOOBJ>
                        </VAR>
                        <VAR name = "GravityFile">
                            <STRING>&quot;STKData\CentralBodies\Moon\GL0660B.grv&quot;</STRING>
                        </VAR>
                        <VAR name = "Degree">
                            <INT>0</INT>
                        </VAR>
                        <VAR name = "Order">
                            <INT>0</INT>
                        </VAR>
                        <VAR name = "PartialsDegree">
                            <INT>0</INT>
                        </VAR>
                        <VAR name = "PartialsOrder">
                            <INT>0</INT>
                        </VAR>
                        <VAR name = "SolidTideType">
                            <STRING>&quot;None&quot;</STRING>
                        </VAR>
                        <VAR name = "IncludeTimeDependentSolidTides">
                            <BOOL>false</BOOL>
                        </VAR>
                        <VAR name = "TruncateSolidTides">
                            <BOOL>true</BOOL>
                        </VAR>
                        <VAR name = "SolidTideMinAmp">
                            <QUANTITY Dimension = "SmallDistanceUnit" Unit = "m">
                                <REAL>0</REAL>
                            </QUANTITY>
                        </VAR>
                        <VAR name = "UseOceanTides">
                            <BOOL>false</BOOL>
                        </VAR>
                        <VAR name = "OceanTideMinAmp">
                            <QUANTITY Dimension = "SmallDistanceUnit" Unit = "m">
                                <REAL>0</REAL>
                            </QUANTITY>
                        </VAR>
                        <VAR name = "OceanTideMaxDegree">
                            <INT>4</INT>
                        </VAR>
                        <VAR name = "OceanTideMaxOrder">
                            <INT>4</INT>
                        </VAR>
                        <VAR name = "MinRadiusPercent">
                            <QUANTITY Dimension = "Percent" Unit = "unitValue">
                                <REAL>0.99</REAL>
                            </QUANTITY>
                        </VAR>
                        <VAR name = "UseSecularVariations">
                            <BOOL>false</BOOL>
                        </VAR>
                    </SCOPE>
                </VAR>
            </LIST>
        </VAR>
        <VAR name = "UseVOP">
            <BOOL>false</BOOL>
        </VAR>
        <VAR name = "UseRegularizedTime">
            <BOOL>false</BOOL>
        </VAR>
        <VAR name = "RegularizedTimeExponent">
            <REAL>1.5</REAL>
        </VAR>
        <VAR name = "RegularizedTimeStepsPerOrbit">
            <INT>90</INT>
        </VAR>
    </SCOPE>
</VAR>